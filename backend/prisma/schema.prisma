generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum GroupRole {
  admin
  member
}

enum Permission {
  READ
  WRITE
  DELETE
  OWNER
}

model User {
  user_id       Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  is_active     Boolean  @default(true)
  role          Role     @default(user)

  files       File[]
  permissions FilePermission[]
  folders     Folder[]
  views       FileViewHistory[]
  groupsMade  StorageGroup[]
  memberships GroupMember[]
  sharedFiles GroupFile[]

  @@map("users")
}

model File {
  file_id     String   @id @default(uuid()) @db.Uuid
  owner_id    Int
  file_name   String
  file_size   BigInt
  file_type   String
  uploaded_at DateTime @default(now())
  deleted_at  DateTime?
  folder_id   String?  @db.Uuid

  owner       User              @relation(fields: [owner_id], references: [user_id], onDelete: Restrict)
  folder      Folder?           @relation(fields: [folder_id], references: [folder_id], onDelete: Restrict)
  permissions FilePermission[]
  views       FileViewHistory[]
  groups      GroupFile[]

  @@index([owner_id])
  @@index([owner_id, folder_id])
  @@map("files")
}

model FilePermission {
  permission_id Int        @id @default(autoincrement())
  file_id       String     @db.Uuid
  user_id       Int
  permission    Permission

  file File @relation(fields: [file_id], references: [file_id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([file_id, user_id, permission])
  @@index([user_id])
  @@map("file_permissions")
}

model Folder {
  folder_id        String   @id @default(uuid()) @db.Uuid
  owner_id         Int
  parent_folder_id String?  @db.Uuid
  folder_name      String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  owner    User     @relation(fields: [owner_id], references: [user_id], onDelete: Restrict)
  parent   Folder?  @relation("FolderTree", fields: [parent_folder_id], references: [folder_id], onDelete: Restrict)
  children Folder[] @relation("FolderTree")
  files    File[]

  @@index([owner_id, parent_folder_id])
  @@map("folders")
}

model FileViewHistory {
  view_id   Int      @id @default(autoincrement())
  user_id   Int
  file_id   String   @db.Uuid
  viewed_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  file File @relation(fields: [file_id], references: [file_id], onDelete: Cascade)

  @@unique([user_id, file_id])
  @@index([user_id, viewed_at(sort: Desc)])
  @@map("file_view_history")
}

model StorageGroup {
  group_id   String   @id @default(uuid()) @db.Uuid
  group_name String
  created_by Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  creator User          @relation(fields: [created_by], references: [user_id], onDelete: Restrict)
  members GroupMember[]
  files   GroupFile[]

  @@index([created_by])
  @@map("storage_groups")
}

model GroupMember {
  group_id  String    @db.Uuid
  user_id   Int
  role      GroupRole @default(member)
  joined_at DateTime  @default(now())

  group StorageGroup @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  user  User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([group_id, user_id])
  @@index([user_id])
  @@map("group_members")
}

model GroupFile {
  group_file_id Int      @id @default(autoincrement())
  group_id      String   @db.Uuid
  file_id       String   @db.Uuid
  shared_by     Int
  shared_at     DateTime @default(now())

  group  StorageGroup @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  file   File         @relation(fields: [file_id], references: [file_id], onDelete: Cascade)
  sharer User         @relation(fields: [shared_by], references: [user_id], onDelete: Restrict)

  @@unique([group_id, file_id])
  @@index([file_id])
  @@index([group_id, shared_at(sort: Desc)])
  @@map("group_files")
}
