DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
MONGODB_URI="mongodb://localhost:27017/lilcloud"

# where uploaded file contents are stored on this machine (default: ./uploads)
# STORAGE_DIR="/Users/you/lilcloud-storage"
# frontend origins allowed to call the API, comma separated (no wildcard)
# CORS_ORIGINS="https://your-frontend.example.com,http://localhost:5173"

# waitlist notifications: signups are always saved; the email is sent only if SMTP is set
# (for Gmail use smtp.gmail.com, port 465 and an app password)
# WAITLIST_NOTIFY_EMAIL="shamanshetty0007@gmail.com"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="you@gmail.com"
# SMTP_PASS="app-password"
# SMTP_FROM="lilcloud <you@gmail.com>"

# social sign-in (optional). Create OAuth apps and set the redirect URI to
#   <API_PUBLIC_URL>/api/v1/auth/oauth/google/callback   and   .../github/callback
# Redirect URIs must be exact, so use a stable public URL (a named tunnel), not a quick tunnel.
# API_PUBLIC_URL="https://api.example.com"
# FRONTEND_URL="https://app.example.com"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
